# 複製本文件為 .streamlit/secrets.toml（本地），
# 或把下面內容貼到 Streamlit Cloud → App → Settings → Secrets。
# 完整教學見 DEPLOY.md。

ADMIN_PASSWORD = "請改成強密碼"
CLUB_NAME = "澳門大學羽毛球會"
SHEET_ID = "Google Sheet URL 中 /d/ 與 /edit 之間的那串 ID"

[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "金鑰 JSON 裡的 private_key_id"
private_key = "-----BEGIN PRIVATE KEY-----\n金鑰JSON裡的private_key整段（保留\n）\n-----END PRIVATE KEY-----\n"
client_email = "xxx@your-project-id.iam.gserviceaccount.com"
client_id = "金鑰 JSON 裡的 client_id"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "金鑰 JSON 裡的 client_x509_cert_url"
universe_domain = "googleapis.com"
